# ── Server-only (never exposed to the browser) ───────────────────────────────
# TMDB v3 API key — https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# MongoDB connection string for My List (local: mongodb://127.0.0.1:27017/traiflex).
# For the local URI, start the database with `pnpm db:up` (needs Docker).
MONGODB_URI=

# ── Public (shipped to the browser; Firebase web config is not a secret) ────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
